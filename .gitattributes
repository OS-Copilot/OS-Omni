# Keep Unix line endings for shell scripts so they run from bash / WSL.
*.sh text eol=lf
# Windows-native scripts always want CRLF.
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf
# Large macOS benchmark bundles under apx_file must go through LFS for GitHub pushes.
apx_file/macos/**/*.zip filter=lfs diff=lfs merge=lfs -text
