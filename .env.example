# Copy to .env and fill only the providers you actually use.

OPENAI_API_KEY=
OPENAI_BASE_URL=

CODESONLINE_API_KEY=

GEMINI_API_KEY=
GEMINI_API_URL=

INTERN_API_KEY=
INTERN_API_URL=

TAOBAO_API_KEY=
TAOBAO_API_URL=

# Optional local-only Linux model credentials.
HELLOWORLD_MOCK_API_KEY=local-smoke-token
HELLOWORLD_SCRIPTED_API_KEY=local-scripted-token

# Optional Linux runtime overrides.
HELLOWORLD_LINUX_VM_IP=127.0.0.1
HELLOWORLD_LINUX_RUNTIME_PORT=5000
HELLOWORLD_LINUX_RUNTIME_TOKEN=linuxbench-runtime-token
HELLOWORLD_LINUX_VM_PROVIDER=
HELLOWORLD_LINUX_VM_PATH=
HELLOWORLD_LINUX_VM_SNAPSHOT_NAME=
HELLOWORLD_LINUX_VM_HEADLESS=true
HELLOWORLD_LINUX_VM_STOP_ON_EXIT=true
HELLOWORLD_LINUX_VM_USE_PROVIDER_IP=true
HELLOWORLD_LINUX_VM_STORAGE_DIR=/abs/path/to/HelloWorld/platforms/linux/vmware_vm_data
HELLOWORLD_LINUX_VM_IMAGE_URL=
HELLOWORLD_LINUX_VM_IMAGE_ARCHIVE_NAME=
HELLOWORLD_LINUX_VM_IMAGE_NAME=
HELLOWORLD_LINUX_VM_BOOTSTRAP_RUNTIME=true
HELLOWORLD_LINUX_VM_GUEST_USERNAME=
HELLOWORLD_LINUX_VM_GUEST_PASSWORD=
HELLOWORLD_LINUX_VM_GUEST_PYTHON_BIN=python3
HELLOWORLD_LINUX_VM_GUEST_RUNTIME_DIR=/tmp/helloworld_linux_runtime
HELLOWORLD_LINUX_VM_GUEST_INSTALL_DEPS=true
# Windows platform: directory containing the Windows VM qcow2 disk image (WSL path).
# Required for `platforms/windows/start_windows_vm.sh`.
VM_STORAGE_DIR=/mnt/d/path/to/vm-storage
# Windows platform: runtime container image used by HelloWorld launcher.
HELLOWORLD_WINDOWS_IMAGE=helloworld/windows-vm:latest
# Safety switch: keep this false to avoid hard power-off (`docker rm -f`) fallback.
# Set true only if graceful shutdown cannot clean stale containers.
HELLOWORLD_WINDOWS_ALLOW_FORCE_REMOVE=false
# Optional source image for bootstrap script.
HELLOWORLD_WINDOWS_SOURCE_IMAGE=yunta88/helloworld-windows-vm:latest
# Optional golden backup directory used by reset script.
HELLOWORLD_WINDOWS_GOLDEN_STORAGE=/mnt/d/path/to/vm-storage-golden
# Legacy: WAA_SCRIPTS_DIR is also supported for backward compatibility.
# WAA_SCRIPTS_DIR=/mnt/d/path/to/WindowsAgentArena/scripts
