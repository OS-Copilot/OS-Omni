# Copy to the ignored .env.qwen38 file and fill the empty machine-specific values.
# Keep the real key in that local file or supply it through the process environment.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://birdapi.up.railway.app/v1

HELLOWORLD_IMAGE_HISTORY_WINDOW=0
HELLOWORLD_LLM_PROVIDER_RETRY_ATTEMPTS=2
HELLOWORLD_WINDOWS_RUNTIME_TIMEOUT_RETRIES=1
PYTHONUTF8=1
PYTHONIOENCODING=utf-8

# These values describe a VMware runtime-ready baseline, not a portable VM image.
HELLOWORLD_WINDOWS_VM_PROVIDER=vmware
HELLOWORLD_WINDOWS_VM_PATH=
HELLOWORLD_WINDOWS_VM_PASSWORD=
HELLOWORLD_WINDOWS_VM_SNAPSHOT_NAME=
HELLOWORLD_WINDOWS_VM_IP=127.0.0.1
HELLOWORLD_WINDOWS_RUNTIME_PORT=5001
HELLOWORLD_WINDOWS_RUNTIME_TOKEN=
HELLOWORLD_WINDOWS_VM_HEADLESS=true
HELLOWORLD_WINDOWS_VM_STOP_ON_EXIT=true
HELLOWORLD_WINDOWS_VM_USE_PROVIDER_IP=true
HELLOWORLD_WINDOWS_VM_RESET_BETWEEN_TASKS=true
HELLOWORLD_WINDOWS_VM_BOOTSTRAP_RUNTIME=true
HELLOWORLD_WINDOWS_VM_GUEST_USERNAME=User
HELLOWORLD_WINDOWS_VM_GUEST_PASSWORD=
